# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# Voice mode only. Get a key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# "gemini" (default) or "mock": a deterministic offline provider for demos and tests
AI_PROVIDER=gemini

# SQLite file. Created on first run.
DATABASE_PATH=data/interviewpro.db

PORT=5000

# Allowed origin(s) when the client is hosted elsewhere (comma separated). Leave empty for same-origin.
CLIENT_ORIGIN=

# Client build: URL of the API/Socket.IO server when it is not the same origin.
VITE_SOCKET_URL=

NODE_ENV=development
